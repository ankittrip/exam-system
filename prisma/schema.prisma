generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  INSTRUCTOR
  STUDENT
}

enum QuestionType {
  MCQ
  CODING
}

enum ExamStatus {
  DRAFT
  PUBLISHED
  COMPLETED
  CANCELLED
}

enum AttemptStatus {
  STARTED
  SUBMITTED
  AUTO_SUBMITTED
}

enum ResultStatus {
  PENDING
  PUBLISHED
}

model User {
  id                String   @id @default(cuid())

  firstName         String
  lastName          String

  email             String   @unique
  password          String

  phone             String?
  avatar            String?

  role              Role     @default(STUDENT)

  isActive          Boolean  @default(true)
  isVerified        Boolean  @default(false)

  currentSessionId  String?
  lastLoginAt       DateTime?

  passwordChangedAt DateTime?

  courses           Course[] @relation("InstructorCourses")

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Course {
  id           String   @id @default(cuid())

  title        String
  code         String   @unique
  description  String?

  instructorId String
  instructor   User @relation(
    "InstructorCourses",
    fields: [instructorId],
    references: [id],
    onDelete: Restrict
  )

  isActive     Boolean  @default(true)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}